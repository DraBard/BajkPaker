{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        },
        {
            "name": "Product Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/services/product_service/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/backend/services/product_service",
            "env": {
                "SQLITE_PATH": "${workspaceFolder}/backend/services/product_service/product_service.db",
                "ALLOWED_ORIGINS": "http://localhost:3000",
                "ENVIRONMENT": "development",
                "DB_ECHO": "True"
            }
        },
        {
            "name": "Order Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/services/order_service/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/backend/services/order_service",
            "env": {
                "SQLITE_PATH": "${workspaceFolder}/backend/data/order_service.db",
                "FRONTEND_URL": "http://localhost:8080",
                "ENVIRONMENT": "development"
            }
        },
        {
            "name": "User Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/services/user_service/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/backend/services/user_service",
            "env": {
                "SQLITE_PATH": "${workspaceFolder}/backend/data/user_service.db",
                "ENVIRONMENT": "development"
            }
        },
        {
            "name": "Update Image Metadata",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/services/product_service/images_upload/update_image_metadata.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/backend/services/product_service/images_upload",
            "env": {
                "SQLITE_PATH": "${workspaceFolder}/backend/services/product_service/product_service.db",
                "ENVIRONMENT": "development"
            }
        }
    ],
    "compounds": [
        {
            "name": "Run All Services",
            "configurations": [
                "Update Image Metadata",
                "Product Service",
                "Order Service", 
                // "User Service",
                "Frontend"
            ],
            "stopAll": true
        }
    ],
}
